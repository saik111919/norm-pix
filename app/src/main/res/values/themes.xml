<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Matches CashflowTheme.kt's default (GREEN) seed light surface/primary, so the window
         behind Compose never flashes the stock Material white before CashflowApp() draws. -->
    <style name="Theme.NormPix" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFF5FBF5</item>
    </style>

    <style name="Theme.NormPix.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFF5FBF5</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.NormPix</item>
    </style>
</resources>
