<?xml version="1.0" encoding="utf-8"?>
<!-- The watch dial widget: two rings of five-minute numbers, the hour in the middle and the minute in the pill at three o'clock.
     The face and the inner ring are a picture (WatchDialRenderer) that ClockWidget draws again every few seconds, so the numbers can
     stay upright as the inner ring steps; the outer (seconds) ring turns by itself, as an animation over the picture; the hour and
     the minute are TextClocks, which the platform keeps on time between those draws.
     ClockWidget sizes the text and puts the minute in its pill for the widget's size. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The picture is square and drawn at a fixed size, which fitCenter scales to the face. It says nothing to a screen reader:
         the TextClocks do. -->
    <ImageView
        android:id="@+id/widget_clock_rings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <!-- The seconds ring, over the picture: ClockWidget adds the view that turns it - from Android 12 an AnalogClock the system turns
         (widget_dial_bezel), before that a progress bar running the ring's animation from the second it is (widget_dial_seconds_NN).
         It is empty until then. -->
    <FrameLayout
        android:id="@+id/widget_clock_seconds"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- The pill at three o'clock again, over the ring, so the ring passes behind it and the second's number in it is never crossed
         by the ring's. Fitted to the face as the picture is. -->
    <ImageView
        android:id="@+id/widget_clock_pill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_dial_pill" />

    <TextClock
        android:id="@+id/widget_clock_hour"
        tools:ignore="SpUsage,UnusedAttribute"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/gs_flex"
        android:format12Hour="hh"
        android:format24Hour="HH"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_clock_ink"
        android:textFontWeight="560"
        android:textSize="40dp" />

    <!-- Its left padding moves the minute from the middle to the pill (ClockWidget sets it for the size). The TextClocks' sizes are
         in dp on purpose - the face, not the phone's text size, decides them - and their weight is GS Flex's from Android 9. -->
    <FrameLayout
        android:id="@+id/widget_clock_minute_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextClock
            android:id="@+id/widget_clock_minute"
            tools:ignore="SpUsage,UnusedAttribute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/gs_flex"
            android:format12Hour="mm"
            android:format24Hour="mm"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_clock_ink"
            android:textFontWeight="560"
            android:textSize="15dp" />
    </FrameLayout>

    <!-- The second, in the pill where the ring's number for it passes the pointer: a TextClock, so the platform keeps it exact.
         Its left padding moves it there, as the minute's does. Not read out: it changes every second. -->
    <FrameLayout
        android:id="@+id/widget_clock_second_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no">

        <TextClock
            android:id="@+id/widget_clock_second"
            tools:ignore="SpUsage,UnusedAttribute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/gs_flex"
            android:format12Hour="ss"
            android:format24Hour="ss"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_clock_ink"
            android:textFontWeight="560"
            android:textSize="12dp" />
    </FrameLayout>
</FrameLayout>
