<?xml version="1.0" encoding="utf-8"?>
<!-- The Add widget: 2 x 1 to start; one cell for the single button, wider for expense, income and transfer. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_add_description"
    android:initialLayout="@layout/widget_add"
    android:maxResizeHeight="120dp"
    android:minHeight="40dp"
