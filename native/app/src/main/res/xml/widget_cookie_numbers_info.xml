<?xml version="1.0" encoding="utf-8"?>
<!-- The cookie clock with numerals: 2 x 2 to start, resizable; never updated on a timer (see widget_cookie_analog_info). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    android:description="@string/widget_cookie_numbers_description"
    android:initialLayout="@layout/widget_cookie_numbers"
    android:maxResizeHeight="280dp"
    android:maxResizeWidth="280dp"
    android:minHeight="110dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="40dp"
    android:configure="com.example.normpix.widgets.ClockWidgetConfigActivity"
    android:minWidth="110dp"
    android:previewImage="@drawable/widget_cookie_numbers_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="2"
    android:updatePeriodMillis="0"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:widgetCategory="home_screen" />
