<?xml version="1.0" encoding="utf-8"?>
<!-- The watch dial widget: 2 x 2 to start, resizable. It never asks to be updated (updatePeriodMillis 0): the platform keeps the
     hour and the minute, and NormPix draws the rings again every few seconds (ClockWidget, WatchDialTicker) and when it is resized or its Widget settings change. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    android:description="@string/widget_clock_description"
    android:initialLayout="@layout/widget_clock"
    android:maxResizeHeight="280dp"
    android:maxResizeWidth="280dp"
    android:minHeight="110dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="40dp"
    android:configure="com.example.normpix.widgets.ClockWidgetConfigActivity"
    android:minWidth="110dp"
    android:previewImage="@drawable/widget_clock_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="2"
    android:updatePeriodMillis="0"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:widgetCategory="home_screen" />
