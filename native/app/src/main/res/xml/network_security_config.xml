<?xml version="1.0" encoding="utf-8"?>
<!-- NormPix reaches GitHub only, to check for updates and download them (`updates/`, which keeps the same list of hosts in
     UpdateNetwork.kt). Every other host is refused: the base configuration trusts no certificate at all, and nothing
     goes over plain HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors />
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <!-- The releases API, the release download links, and the hosts GitHub redirects those downloads to. -->
        <domain includeSubdomains="false">api.github.com</domain>
        <domain includeSubdomains="false">github.com</domain>
        <domain includeSubdomains="false">objects.githubusercontent.com</domain>
        <domain includeSubdomains="false">release-assets.githubusercontent.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
