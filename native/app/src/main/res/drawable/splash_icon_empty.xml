<?xml version="1.0" encoding="utf-8"?>
<!--
  The icon of Android's own launch screen (12 and later): nothing. Android always draws a launch screen over a cold start and will
  not let an app switch it off; the way to have only the app's own splash (the cookie) is to make that one an empty screen in
  the window's colour, which the cookie then grows from. A fully transparent path, because a drawable with nothing in it is not
  accepted as an icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0h24v24h-24z" />
</vector>
