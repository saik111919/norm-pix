<?xml version="1.0" encoding="utf-8"?>
<!-- A pressable area with no surface of its own (a widget's heading): a ripple inside the inner corner. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/widget_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="@dimen/widget_inner_radius" />
        </shape>
    </item>
</ripple>
