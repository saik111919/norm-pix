<?xml version="1.0" encoding="utf-8"?>
<!-- One transaction in the Recent widget: a tonal row with the inner corner, which ripples when pressed. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/widget_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_container" />
            <corners android:radius="@dimen/widget_inner_radius" />
        </shape>
    </item>
</ripple>
