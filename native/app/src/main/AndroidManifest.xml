<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Optional features: the app works without NFC or a camera. -->
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.nfc.hce" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Everything NormPix holds stays on the device. Its one connection is to GitHub, to check for and download
         updates (`updates/`): network_security_config.xml refuses every other host, and the telemetry upload ML Kit
         brings along is taken out below. The network state permission is for the daily update check in the background
         alone: Android needs it to wait for a network (Wi-Fi, for a download) before running it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Hands a downloaded update to Android's installer, which asks the user before it installs anything - unless the
         user chose to have updates installed automatically, where Android (12 and later) lets an app update itself
         without asking. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Keeps an update download the user asked for going with NormPix closed, its progress in a notification
         (`UpdateDownloadService`). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- The clock widget opens the phone's clock app when tapped (NormPix where there is none). -->
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
    </queries>

    <application
        android:name=".NormPixApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.NormPix">

        <!-- Hands the system camera app a private cache file to write a card photo to, and the share sheet a rendered receipt. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.scanfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/scan_file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|density|uiMode|fontScale|locale|layoutDirection" />

        <!-- The launcher entries, one per icon the user can pick in Settings > Appearance > App icon (`AppIcon`), each
             opening MainActivity. Only the default is enabled here; `AppIcons.use` enables one and disables the rest.
             Everything else (shares, notifications) opens MainActivity itself, so it works whichever icon is on. -->
        <activity-alias
            android:name=".IconDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconGlossy"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_glossy"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconComic"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_comic"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconMinimal"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_minimal"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconFlat"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_flat"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconGlass"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_glass"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconClay"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_clay"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconPixel"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pixel"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconPaper"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_paper"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconNeon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_neon"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Share sheet target: text or a receipt picture shared from a payment or bank app becomes a transaction
             draft the user checks and saves (a picture's text is read on the device). Shows nothing itself; it hands
             the share to the app in memory and brings up MainActivity's own task, so the main screen is never opened a
             second time inside the sharing app's task. -->
        <activity
            android:name=".finance.share.ShareTransactionActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Home-screen widgets. Only the system's widget service reaches them (not exported). The watch dial keeps its hour and minute by itself
             (TextClock) and has its rings drawn again every minute by an alarm that wakes nothing; the cookie clocks keep time by
             themselves (AnalogClock and TextClock); the Add widget only opens the app; the Recent widget is drawn again by the app when
             the ledger changes, and here when the day turns (its own alarm, or a restart or a change of clock). -->
        <receiver
            android:name=".widgets.ClockWidget"
            android:exported="false"
            android:label="@string/widget_clock_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock_info" />
        </receiver>
        <receiver
            android:name=".widgets.CookieAnalogWidget"
            android:exported="false"
            android:label="@string/widget_cookie_analog_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_cookie_analog_info" />
        </receiver>
        <receiver
            android:name=".widgets.CookieNumbersWidget"
            android:exported="false"
            android:label="@string/widget_cookie_numbers_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_cookie_numbers_info" />
        </receiver>
        <receiver
            android:name=".widgets.CookieDigitalWidget"
            android:exported="false"
            android:label="@string/widget_cookie_digital_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_cookie_digital_info" />
        </receiver>
        <receiver
            android:name=".widgets.RecentWidget"
            android:exported="false"
            android:label="@string/widget_recent_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_recent_info" />
        </receiver>
        <receiver
            android:name=".widgets.AddWidget"
            android:exported="false"
            android:label="@string/widget_add_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_add_info" />
        </receiver>
        <!-- NFC Outlet Host Card Emulation Service for two-way card exchange -->
        <service
            android:name=".wallet.nfc.NfcCardOutletService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/apduservice" />
        </service>

        <!-- Reminders: the alarm that fires a notification, its Complete / Snooze
             buttons, and re-arming alarms after a reboot or app update. -->
        <receiver
            android:name=".reminders.ReminderAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminders.ReminderActionReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminders.ReminderBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Card expiry: the daily reminder alarm, its "Mark as done" button, and re-arming the alarms
             after a reboot, an app update, or a change of clock or time zone (the reminders are date-based). -->
        <receiver
            android:name=".wallet.expiry.CardExpiryAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".wallet.expiry.CardExpiryActionReceiver"
            android:exported="false" />
        <receiver
            android:name=".wallet.expiry.CardExpiryBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Clipboard: finishes clearing a copied card detail if the app process is gone when its time is up. -->
        <receiver
            android:name=".wallet.clipboard.ClipboardClearReceiver"
            android:exported="false" />

        <!-- Updates: Android's installer reports here how installing a downloaded update went (or that it needs the
             user to confirm). Only the installer, through the app's own PendingIntent, can reach it. -->
        <receiver
            android:name=".updates.UpdateInstallReceiver"
            android:exported="false" />

        <!-- Updates: a download the user started carries on with NormPix closed, as a foreground service whose
             notification shows how far it is (with Cancel); Download on the "update available" notification starts it too. -->
        <service
            android:name=".updates.UpdateDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <receiver
            android:name=".updates.UpdateActionReceiver"
            android:exported="false" />

        <!-- Updates: the daily check in the background, run by Android's JobScheduler (only it can bind the service). -->
        <service
            android:name=".updates.UpdateJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- ML Kit's telemetry transport (TransportBackendDiscovery) is left without its backend by app/build.gradle.kts, in
             the merged manifest of every build: it would upload usage logs to Google once the app may use the network. -->

    </application>
</manifest>
